+# Back-off between failed polls of a peer-written flag. A waiting rank otherwise re-reads
+# its flags as fast as the memory system answers: on TP8 RTX PRO 6000 that polling raised
+# board power from ~205 W to ~285 W while decode waited on a late peer, pushing cards into
+# their power cap, which made the next wait longer (a self-sustaining slow state).
+POLL_BACKOFF_NS = 128
+
+
+@dsl_user_op
+def nanosleep_u32(nanoseconds: Uint32, *, loc=None, ip=None) -> None:
+    llvm.inline_asm(
+        None,
+        [Uint32(nanoseconds).ir_value(loc=loc, ip=ip)],
+        "nanosleep.u32 $0;",
+        "r",
+        has_side_effects=True,
+        is_align_stack=False,
+        asm_dialect=llvm.AsmDialect.AD_ATT,
+        loc=loc,
+        ip=ip,
+    )
+
+
 @dsl_user_op
 def ld_relaxed_gpu_u32(addr: Int64, *, loc=None, ip=None) -> Uint32:
     return Uint32(
@@ -619,7 +644,10 @@
         generation_wait:
             ld.acquire.gpu.global.u32 seen, [$0];
             setp.eq.u32 same, seen, $1;
-            @same bra generation_wait;
+            @!same bra generation_done;
+            nanosleep.u32 128;
+            bra generation_wait;
+        generation_done:
         }
         """,
         "l,r",
