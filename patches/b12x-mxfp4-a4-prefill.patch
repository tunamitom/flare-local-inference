+    cp_async_u32_shared_global,
+    get_ptr_as_int64,
+    ld_global_nc_v4_u32,
+    ld_shared_v2_u32,
+    ld_shared_v4_u32,
+    shared_ptr_to_u32,
+    st_global_u32,
+    st_global_v4_u32,
+    u32_as_f32,
+)
